DISCORD_CLIENT_SECRET=<from the portal>
DISCORD_REDIRECT_URI=https://<your-domain>/oauth/callback
BOT_API_URL=<url>
BOT_API_TOKEN=<the same value as DASHBOARD_API_TOKEN in the bot>

# optional
# FLASK_DEBUG=0/1         # default: 1
# DISCORD_CLIENT_ID=      # default: taken from the invite link in data.py
# SECRET_KEY=             # default: generated once into instance/secret_key
# DEVI_SESSION_DAYS=7     # days a session lives after its last use
# DEVI_SESSION_DB=        # default: instance/sessions.sqlite3
# DEVI_LOG_LEVEL=INFO     # sign-ins and rejected sessions are logged
